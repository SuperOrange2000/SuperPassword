<UserControl
    x:Class="SuperPassword.UI.Views.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:SuperPassword.UI.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="500"
    d:DesignWidth="300"
    x:CompileBindings="True"
    x:DataType="vm:LoginViewModel"
    mc:Ignorable="d">
    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Initialized">
            <InvokeCommandAction Command="{Binding LoadCompletedCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>
    <Grid RowDefinitions="5*,*,*,*,3*">
        <Image Source="/Assets/logo_512.png" />
        <ToggleSwitch
            Grid.Row="1"
            HorizontalAlignment="Center"
            Classes.Loading="{Binding IsServerSwitching}"
            Command="{Binding SwitchServerCommand}"
            IsChecked="{Binding EnableServer}"
            IsEnabled="{Binding !IsServerSwitching}"
            OffContent="离线模式"
            OnContent="同步模式(实验性）" />
        <StackPanel
            Grid.Row="2"
            Margin="10,5"
            VerticalAlignment="Center">
            <TextBox
                Padding="10,2"
                VerticalAlignment="Center"
                Text="{Binding ActiveUser.Name, Mode=OneWayToSource}"
                Watermark="账号">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="GotFocus">
                        <InvokeCommandAction Command="{Binding ClearNoticeCommand}" CommandParameter="username" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </TextBox>
            <TextBlock
                Margin="8,0"
                Classes="Danger"
                IsVisible="{Binding !!$self.Text.Length}"
                Text="{Binding UserNameNotice}" />
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            Margin="10,2"
            VerticalAlignment="Center">
            <TextBox
                Padding="10,5"
                VerticalAlignment="Center"
                Classes="revealPasswordButton"
                PasswordChar="●"
                Text="{Binding ActiveUser.Password, Mode=OneWayToSource}"
                Watermark="密码">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="GotFocus">
                        <InvokeCommandAction Command="{Binding ClearNoticeCommand}" CommandParameter="password" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
            </TextBox>
            <TextBlock
                Margin="8,0"
                Classes="Danger"
                IsVisible="{Binding !!$self.Text.Length}"
                Text="{Binding PasswordNotice}" />
        </StackPanel>

        <DockPanel Grid.Row="4">
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ColumnDefinitions="*,*">
                <Button
                    Margin="10,0"
                    Padding="20,10"
                    Classes="Success Large"
                    Command="{Binding SignUpCommand}"
                    CommandParameter="{Binding ActiveUser}"
                    Content="注册" />
                <Button
                    Grid.Column="1"
                    Margin="10,0"
                    Padding="20,10"
                    Classes="Large"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ActiveUser}"
                    Content="登录" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

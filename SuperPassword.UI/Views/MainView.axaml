<UserControl
    x:Class="SuperPassword.UI.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SuperPassword.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:SuperPassword.UI.Interactions"
    xmlns:m="using:SuperPassword.UI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:SuperPassword.UI.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <StreamGeometry x:Key="Dice" />
        <converters:MutiParametersConverter x:Key="MutiParametersConverter" />
    </UserControl.Resources>

    <Grid Margin="5,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="10" LastChildFill="True">
            <Button
                MinWidth="50"
                VerticalAlignment="Stretch"
                Command="{Binding AddCommand}"
                Content="新增"
                DockPanel.Dock="Right" />
            <u:TagInput
                Margin="0,0,10,0"
                VerticalAlignment="Stretch"
                Tags="{Binding FilterTags}"
                Watermark="筛选" />
        </DockPanel>
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding InfoGroupViewItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Classes="Hover Hiddenable"
                            Classes.AllVisiable="{ReflectionBinding !$parent[ItemsControl].DataContext.FilterTags.Count}"
                            Classes.SelfVisiable="{Binding Visibility, Mode=TwoWay}"
                            Theme="{StaticResource CardBorder}">
                            <Border.Styles>
                                <Style Selector="Border.Hiddenable">
                                    <Setter Property="IsVisible" Value="False" />
                                </Style>
                                <Style Selector="Border.AllVisiable.Hiddenable">
                                    <Setter Property="IsVisible" Value="True" />
                                </Style>
                                <Style Selector="Border.SelfVisiable.Hiddenable">
                                    <Setter Property="IsVisible" Value="True" />
                                </Style>
                            </Border.Styles>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsEditable}"
                                        Text="{Binding Site}" />
                                    <TextBox
                                        MinWidth="200"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsEditable}"
                                        Text="{Binding Site}"
                                        Watermark="名称" />
                                    <Button
                                        Margin="10,0,0,0"
                                        Classes="Danger Small"
                                        Command="{ReflectionBinding $parent[ItemsControl].DataContext.DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Content="删除"
                                        DockPanel.Dock="Right"
                                        FontWeight="550"
                                        Theme="{DynamicResource SolidButton}" />
                                    <ToggleButton
                                        Classes="Success Small"
                                        Classes.isEditable="{Binding $self.IsChecked}"
                                        Command="{ReflectionBinding $parent[ItemsControl].DataContext.UpdateCommand}"
                                        CommandParameter="{Binding}"
                                        DockPanel.Dock="Right"
                                        FontWeight="550"
                                        IsChecked="{Binding IsEditable}">
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton">
                                                <Setter Property="Content" Value="修改" />
                                            </Style>
                                            <Style Selector="ToggleButton.isEditable">
                                                <Setter Property="Content" Value="完成" />
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                    <u:TagInput
                                        Margin="10,0"
                                        AllowDuplicates="False"
                                        IsTabStop="True"
                                        IsVisible="{Binding IsEditable}"
                                        LostFocusBehavior="Add"
                                        Tags="{Binding EditingTags}"
                                        Watermark="标签" />
                                    <ListBox
                                        Margin="10,0"
                                        IsVisible="{Binding !IsEditable}"
                                        ItemsSource="{Binding ViewTags}"
                                        SelectionMode="Multiple,Toggle"
                                        Theme="{DynamicResource ButtonRadioGroupListBox}">
                                        <ListBox.ItemContainerTheme>
                                            <!--  x:DataType="m:Tag"  -->
                                            <ControlTheme BasedOn="{StaticResource ButtonRadioGroupListBoxItem}" TargetType="ListBoxItem">
                                                <!--<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />-->
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </ControlTheme>
                                        </ListBox.ItemContainerTheme>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Button
                                                        Classes.Primary="{Binding IsSelected}"
                                                        Classes.Tertiary="{Binding !IsSelected}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.TagClickCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Content}" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Grid ColumnDefinitions="*,*">
                                    <Border
                                        Padding="0,10"
                                        Classes="Hover"
                                        IsVisible="{Binding !IsEditable}"
                                        Theme="{StaticResource CardBorder}">
                                        <TextBlock HorizontalAlignment="Center" Text="用户名" />
                                        <Interaction.Behaviors>
                                            <EventTriggerBehavior EventName="PointerPressed">
                                                <i:InvokeCommandActionWithArgs
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DraggingCommand}"
                                                    CommandParameter="{Binding Username}"
                                                    ParametersConverter="{StaticResource MutiParametersConverter}"
                                                    PassEventArgsToCommand="True" />
                                            </EventTriggerBehavior>
                                        </Interaction.Behaviors>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="0,10"
                                        Classes="Hover"
                                        IsVisible="{Binding !IsEditable}"
                                        Theme="{StaticResource CardBorder}">
                                        <TextBlock HorizontalAlignment="Center" Text="密码" />
                                        <Interaction.Behaviors>
                                            <EventTriggerBehavior EventName="PointerPressed">
                                                <i:InvokeCommandActionWithArgs
                                                    Command="{ReflectionBinding $parent[UserControl].DataContext.DraggingCommand}"
                                                    CommandParameter="{Binding Password}"
                                                    ParametersConverter="{StaticResource MutiParametersConverter}"
                                                    PassEventArgsToCommand="True" />
                                            </EventTriggerBehavior>
                                        </Interaction.Behaviors>
                                    </Border>
                                </Grid>
                                <TextBox
                                    Margin="0,10"
                                    IsVisible="{Binding IsEditable}"
                                    Text="{Binding Username}"
                                    Watermark="用户名" />
                                <TextBox
                                    IsVisible="{Binding IsEditable}"
                                    Text="{Binding Password}"
                                    Watermark="密码">
                                    <TextBox.InnerRightContent>
                                        <u:IconButton>
                                            <u:IconButton.Icon>
                                                <TextBlock Text="🎲" />
                                            </u:IconButton.Icon>
                                        </u:IconButton>
                                    </TextBox.InnerRightContent>
                                </TextBox>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>

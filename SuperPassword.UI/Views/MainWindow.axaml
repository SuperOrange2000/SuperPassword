<u:UrsaWindow
    x:Class="SuperPassword.UI.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="using:SuperPassword.UI.Services"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:views="clr-namespace:SuperPassword.UI.Views"
    xmlns:vm="using:SuperPassword.UI.ViewModels"
    Title="SuperPassword"
    Width="{Binding Width}"
    Height="{Binding Height}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/logo_32.ico"
    mc:Ignorable="d">
    <u:UrsaWindow.RightContent>
        <u:ThemeToggleButton
            Name="ThemeToggleButton"
            IsThreeState="True"
            Mode="Controller" />
    </u:UrsaWindow.RightContent>
    <Panel Margin="0,40,0,0">
        <ContentControl Content="{Binding CurrentViewModel}">
            <ContentControl.DataTemplates>
                <s:ViewLocator />
            </ContentControl.DataTemplates>
        </ContentControl>
        <u:OverlayDialogHost />
    </Panel>
</u:UrsaWindow>
